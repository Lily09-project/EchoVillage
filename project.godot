config_version=5

[application]
config/name="Echo Village"
config/description="AI-Driven NPC Life Simulation RPG"
config/version="1.4.0"
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.2")
config/icon="res://assets/portfolio/echo_village_cover.svg"

[autoload]
EventBus="*res://scripts/core/event_bus.gd"
GameTime="*res://scripts/time/game_time_manager.gd"
WorldEventManager="*res://scripts/events/world_event_manager.gd"
GameManager="*res://scripts/core/game_manager.gd"
SaveManager="*res://scripts/save/save_manager.gd"
SoundManager="*res://scripts/audio/sound_manager.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
